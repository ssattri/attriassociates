# Public Supabase connection values (safe for the browser; access is protected by RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only integrations — never prefix these with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=sb_secret_replace_me
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me
BREVO_API_KEY=replace_me
MSG91_AUTH_KEY=replace_me
WHATSAPP_ACCESS_TOKEN=replace_me
CRON_SECRET=generate_a_long_random_value
NEXT_PUBLIC_SITE_URL=http://localhost:3000
